cabal-version:   3.0
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md
synopsis:        The Cabal bridge around pubgrub and pubgrub-cabal
description:
    The library the unpublished executables share: the Hackage index reader,
    the derived index, the compiler's world on this machine, and cabal's own
    solver as the baseline. The solver is the @pubgrub@ package and its cabal
    instantiation is @pubgrub-cabal@, both in this repository.

common warnings
    ghc-options: -Wall

library
    import:             warnings
    hs-source-dirs:     src
    exposed-modules:
        Bridge.Cabal.Baseline
        Bridge.Cabal.InstalledPkg
        Bridge.Hackage
        Bridge.Hackage.HttpClient
        Bridge.Hackage.Store
        Bridge.Hackage.Unlifted
        Bridge.Log
        Bridge.Provider
    build-depends:
        , array
        , base
        , binary
        , bytestring
        , Cabal
        , cabal-install-solver >=3.14.2 && <3.20
        , Cabal-syntax
        , containers
        , co-log-core >=0.3.2 && <0.4
        , directory
        , filepath
        , hackage-security
        , http-client
        , http-types
        , mtl
        , network-uri
        , pubgrub
        , pubgrub-cabal
        , process
        , serialise
        , text
        , time
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        FlattenSpec
        IndexStateSpec
        StoredSpec
    build-depends:
        , pubgrub
        , pubgrub-cabal
        , pubgrub-hs
        , base
        , binary
        , bytestring
        , cabal-install-solver
        , Cabal-syntax
        , containers
        , serialise
        , tasty
        , tasty-hunit
        , text
    hs-source-dirs:   test
    default-language: GHC2021
