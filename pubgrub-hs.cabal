cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- The expected proofs that test/PaperSpec.hs compares against. The test-suite
-- reads them at run time, so the source distribution must ship them.
extra-source-files: test/golden/*.txt

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        PubGrub
        PubGrub.Cabal
        PubGrub.Derivation
        PubGrub.Incompatibility
        PubGrub.Index.PreInstalled
        PubGrub.InstanceSet
        PubGrub.Pretty
        PubGrub.Provider
        PubGrub.Relation
        PubGrub.Report
        PubGrub.Report.Headline
        PubGrub.Report.Layout
        PubGrub.Report.Rule
        PubGrub.Report.Wording
        PubGrub.SetOps
        PubGrub.Solver
        PubGrub.Store
        PubGrub.Term
        PubGrub.Value
        PubGrub.Variable
        PubGrub.Version
        PubGrub.VersionSet
    build-depends:
        , base ^>=4.21.0.0
        , co-log-core
        , containers
        , Cabal-syntax
        , text
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: ImportQualifiedPost

-- The cabal provider: the translation from .cabal files and an installed package
-- set into the solver's input, and the rule that picks an instance of a package
-- and states what it entails. Public, and of the cabal ecosystem it needs
-- Cabal-syntax only, so another tool can drive the solver over its own index,
-- installed world and pkg-config without this repository's index reader (the
-- private `bridge` below) or cabal-install-solver.
library cabal
    import:             warnings
    visibility:         public
    hs-source-dirs:     cabal
    exposed-modules:
        PubGrub.Cabal.Flatten
        PubGrub.Cabal.Installed
        PubGrub.Cabal.Provider
    build-depends:
        , base
        , Cabal-syntax
        , co-log-core
        , containers
        , pubgrub-hs
        , text
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

library bridge
    import:             warnings
    visibility:         private
    hs-source-dirs:     bridge
    exposed-modules:
        Bridge.Cabal.Baseline
        Bridge.Cabal.InstalledPkg
        Bridge.Hackage
        Bridge.Hackage.HttpClient
        Bridge.Hackage.Store
        Bridge.Hackage.Unlifted
        Bridge.Provider
    build-depends:
        , array
        , base
        , binary
        , bytestring
        , Cabal
        , cabal-install-solver ^>=3.14.2.0
        , Cabal-syntax
        , containers
        , co-log
        , directory
        , filepath
        , hackage-security
        , http-client
        , http-types
        , network-uri
        , pubgrub-hs
        , pubgrub-hs:cabal
        , process
        , serialise
        , text
        , time
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

executable pubgrub
    import:             warnings
    -- -rtsopts so a run can be asked for GC statistics (+RTS -s) or a heap
    -- profile without rebuilding; peak residency is one of the two things this
    -- project exists to measure.
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:
        , base
        , Cabal
        , cabal-install-solver
        , Cabal-syntax
        , co-log
        , containers
        , hackage-security
        , http-client
        , mtl
        , optparse-applicative
        , pubgrub-hs
        , pubgrub-hs:bridge
        , pubgrub-hs:cabal
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        ConstraintSpec
        FlagSolveSpec
        FlattenSpec
        IndexStateSpec
        InstalledSpec
        InstanceSetSpec
        PaperSpec
        PartialSolutionSpec
        ReportSpec
        SolverSpec
        StoredSpec
        StoreSpec
        ToyDomainSpec
        VersionSetSpec
    build-depends:
        , pubgrub-hs
        , pubgrub-hs:bridge
        , pubgrub-hs:cabal
        , base
        , binary
        , bytestring
        , cabal-install-solver
        , Cabal-syntax
        , co-log
        , containers
        , mtl
        , serialise
        , tasty
        , tasty-golden
        , tasty-hunit
        , tasty-quickcheck
        , text
    hs-source-dirs:   test
    default-language: GHC2021

-- Builds the derived index the bridge reads: every release parsed once and kept
-- in the pre-environment form. See app/BuildIndex.hs and Bridge.Hackage.Store.
executable pubgrub-index
    import:             warnings
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            BuildIndex.hs
    build-depends:
        , base
        , Cabal-syntax
        , co-log
        , containers
        , directory
        , hackage-security
        , http-client
        , mtl
        , optparse-applicative
        , pubgrub-hs:bridge
        , pubgrub-hs:cabal
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

-- The harness: the one command that produces both deliverables. It drives the
-- pubgrub executable as a child process, once per solver, per problem, per
-- repetition, because peak memory is a per-process number, and writes
-- bench/output/benchmark.md and bench/output/showcase.md. See app/Harness.hs and
-- docs/benchmarking.md. It measures; scripts/gate.sh decides.
executable pubgrub-harness
    import:             warnings
    hs-source-dirs:     app
    main-is:            Harness.hs
    build-depends:
        , base
        , bytestring
        , containers
        , directory
        , filepath
        , optparse-applicative
        , process
        , text
        , time
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

