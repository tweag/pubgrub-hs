cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

-- The expected proofs that test/PaperSpec.hs compares against. The test-suite
-- reads them at run time, so the source distribution must ship them.
extra-source-files: test/golden/*.txt

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        PubGrub
        PubGrub.Incompatibility
        PubGrub.Index.PreInstalled
        PubGrub.InstanceSet
        PubGrub.InstanceSet.SourceCell
        PubGrub.Pretty
        PubGrub.Provider
        PubGrub.Relation
        PubGrub.Report
        PubGrub.SetOps
        PubGrub.Solver
        PubGrub.Store
        PubGrub.Term
        PubGrub.VersionSet
    build-depends:
        , base ^>=4.21.0.0
        , co-log
        , containers
        , Cabal-syntax
        , text
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: ImportQualifiedPost

library bridge
    import:             warnings
    visibility:         private
    hs-source-dirs:     bridge
    exposed-modules:
        Bridge.Cabal.Baseline
        Bridge.Cabal.Flatten
        Bridge.Cabal.InstalledPkg
        Bridge.Hackage
        Bridge.Hackage.HttpClient
        Bridge.Hackage.Store
        Bridge.Hackage.Unlifted
        Bridge.Installed
        Bridge.Provider
    build-depends:
        , base
        , binary
        , bytestring
        , Cabal
        , cabal-install-solver ^>=3.14.2.0
        , Cabal-syntax
        , containers
        , co-log
        , directory
        , filepath
        , hackage-security
        , http-client
        , http-types
        , network-uri
        , pubgrub-hs
        , process
        , serialise
        , text
        , time
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

executable pubgrub
    import:             warnings
    -- -rtsopts so a run can be asked for GC statistics (+RTS -s) or a heap
    -- profile without rebuilding; peak residency is one of the two things this
    -- project exists to measure.
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:
        , base
        , Cabal
        , cabal-install-solver
        , Cabal-syntax
        , co-log
        , containers
        , hackage-security
        , http-client
        , mtl
        , optparse-applicative
        , pubgrub-hs
        , pubgrub-hs:bridge
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        FlagSolveSpec
        FlattenSpec
        InstalledSpec
        InstanceSetSpec
        PaperSpec
        PartialSolutionSpec
        ReportSpec
        SolverSpec
        StoredSpec
        StoreSpec
        VersionSetSpec
    build-depends:
        , pubgrub-hs
        , pubgrub-hs:bridge
        , base
        , bytestring
        , cabal-install-solver
        , Cabal-syntax
        , co-log
        , containers
        , mtl
        , serialise
        , tasty
        , tasty-golden
        , tasty-hunit
        , tasty-quickcheck
        , text
    hs-source-dirs:   test
    default-language: GHC2021

-- Builds the derived index the bridge reads: every release parsed once and kept
-- in the pre-environment form. See app/BuildIndex.hs and Bridge.Hackage.Store.
executable pubgrub-index
    import:             warnings
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            BuildIndex.hs
    build-depends:
        , base
        , Cabal-syntax
        , co-log
        , containers
        , directory
        , hackage-security
        , http-client
        , mtl
        , pubgrub-hs:bridge
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

-- A throwaway measurement, not part of the solver: prototype/IndexBench.hs
-- prices the derived pre-environment index (bytes per entry under binary and
-- serialise, and the parse:flatten split).
executable index-bench
    import:             warnings
    ghc-options:        -rtsopts
    hs-source-dirs:     prototype
    main-is:            IndexBench.hs
    build-depends:
        , base
        , binary
        , bytestring
        , Cabal-syntax
        , co-log
        , containers
        , deepseq
        , hackage-security
        , http-client
        , mtl
        , pubgrub-hs
        , pubgrub-hs:bridge
        , serialise
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost
