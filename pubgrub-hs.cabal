cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        PubGrub
        PubGrub.Incompatibility
        PubGrub.Index.PreInstalled
        PubGrub.InstanceSet
        PubGrub.InstanceSet.SourceCell
        PubGrub.Pretty
        PubGrub.Provider
        PubGrub.Relation
        PubGrub.Report
        PubGrub.SetOps
        PubGrub.Solver
        PubGrub.Term
        PubGrub.VersionSet
    build-depends:
        , base ^>=4.21.0.0
        , co-log
        , containers
        , Cabal-syntax
        , text
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: ImportQualifiedPost

library bridge
    import:             warnings
    visibility:         private
    hs-source-dirs:     bridge
    exposed-modules:
        Bridge.Cabal.Flatten
        Bridge.Hackage
        Bridge.Hackage.HttpClient
        Bridge.Hackage.Unlifted
        Bridge.Provider
    other-modules:
        Bridge.Cabal.InstalledPkg
        Bridge.Installed
    build-depends:
        , base
        , binary
        , bytestring
        , Cabal
        , Cabal-syntax
        , containers
        , co-log
        , filepath
        , hackage-security
        , http-client
        , http-types
        , network-uri
        , pubgrub-hs
        , process
        , text
        , time
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

executable pubgrub
    import:             warnings
    -- -rtsopts so a run can be asked for GC statistics (+RTS -s) or a heap
    -- profile without rebuilding; peak residency is one of the two things this
    -- project exists to measure.
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            Main.hs
    build-depends:
        , base
        , Cabal-syntax
        , co-log
        , containers
        , hackage-security
        , http-client
        , mtl
        , pubgrub-hs
        , pubgrub-hs:bridge
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        FlagSolveSpec
        FlattenSpec
        InstanceSetSpec
        PaperSpec
        PartialSolutionSpec
        SolverSpec
        VersionSetSpec
    build-depends:
        , pubgrub-hs
        , pubgrub-hs:bridge
        , base
        , bytestring
        , Cabal-syntax
        , co-log
        , containers
        , tasty
        , tasty-hunit
        , tasty-quickcheck
        , text
    hs-source-dirs:   test
    default-language: GHC2021
