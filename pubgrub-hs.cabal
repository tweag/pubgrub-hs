cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        PubGrub
        PubGrub.Incompatibility
        PubGrub.VersionSet
        PubGrub.Term
        PubGrub.Relation
        PubGrub.InstanceSet
        PubGrub.Solver
        PubGrub.Report
        PubGrub.Pretty
    build-depends:
        , base ^>=4.21.0.0
        , containers
        , Cabal-syntax
        , text
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        VersionSetSpec
    build-depends:
        , pubgrub-hs
        , base
        , Cabal-syntax
        , tasty
        , tasty-quickcheck
    hs-source-dirs:   test
    default-language: GHC2021
