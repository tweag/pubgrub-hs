cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        PubGrub
        PubGrub.VersionSet
        PubGrub.Types
        PubGrub.Solver
        PubGrub.Lattice
        PubGrub.Pow
    build-depends:
        , base ^>=4.21.0.0
        , containers
        , Cabal-syntax
        , text
        , co-log
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: ImportQualifiedPost

library cabal-bridge
    import:           warnings
    exposed-modules:
        PubGrub.Cabal.Flatten
        PubGrub.Cabal.Boot
        PubGrub.Cabal.Compiler
    build-depends:
        , base
        , containers
        , Cabal
        , Cabal-syntax
        , pubgrub-hs
        , filepath
    hs-source-dirs:   app-lib
    default-language: GHC2021

executable pubgrub-hs
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Compiler
        Database
        HackageProvider
        Hackage
        Hackage.Security.Unlifted
        HttpClient
        Solver
        Utils
    build-depends:
        , pubgrub-hs
        , pubgrub-hs:cabal-bridge
        , process
        , Cabal
        , Cabal-syntax
        , base
        , binary
        , bytestring
        , text
        , microlens
        , mtl
        , stm
        , tar
        , time
        , containers
        , optparse-applicative
        , optparse-generic
        , hackage-security
        , http-client
        , http-types
        , network-uri
        , async
        , unliftio
        , co-log
        , scheduler
        , concurrent-output
        , lmdb-simple
        , serialise

    hs-source-dirs:   app
    default-language: GHC2021

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        VersionSetSpec
        SolverSpec
        FlattenSpec
        BootSpec
        CompilerSpec
        LatticeSpec
        PowSpec
    build-depends:
        , pubgrub-hs
        , pubgrub-hs:cabal-bridge
        , bytestring
        , base
        , containers
        , Cabal-syntax
        , tasty
        , tasty-quickcheck
        , tasty-hunit
        , co-log
        , text
    hs-source-dirs:   test
    default-language: GHC2021
