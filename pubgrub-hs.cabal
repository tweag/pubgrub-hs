cabal-version:   3.8
name:            pubgrub-hs
version:         0.1.0.0
license:         BSD-3-Clause
license-files:   LICENSE.md
copyright:       (c) 2026 Tweag I/O by Modus Create
author:          Andrea Bedini
maintainer:      andrea.bedini@moduscreate.com
build-type:      Simple
extra-doc-files: CHANGELOG.md
synopsis:        The research harness around pubgrub and pubgrub-cabal
description:
    The part of the repository that is not published: the Hackage index reader,
    the compiler's world on this machine, cabal's own solver as the baseline,
    the driver, the index builder and the benchmark harness. The solver is the
    @pubgrub@ package and its cabal instantiation is @pubgrub-cabal@, both in
    this repository.

common warnings
    ghc-options: -Wall

library bridge
    import:             warnings
    visibility:         private
    hs-source-dirs:     bridge
    exposed-modules:
        Bridge.Cabal.Baseline
        Bridge.Cabal.InstalledPkg
        Bridge.Hackage
        Bridge.Hackage.HttpClient
        Bridge.Hackage.Store
        Bridge.Hackage.Unlifted
        Bridge.Provider
    build-depends:
        , array
        , base
        , binary
        , bytestring
        , Cabal
        , cabal-install-solver >=3.14.2 && <3.20
        , Cabal-syntax
        , containers
        , co-log
        , directory
        , filepath
        , hackage-security
        , http-client
        , http-types
        , network-uri
        , pubgrub
        , pubgrub-cabal
        , process
        , serialise
        , text
        , time
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

executable pubgrub
    import:             warnings
    -- -rtsopts so a run can be asked for GC statistics (+RTS -s) or a heap
    -- profile without rebuilding; peak residency is one of the two things this
    -- project exists to measure.
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            Main.hs
    other-modules:      Paths_pubgrub_hs
    autogen-modules:    Paths_pubgrub_hs
    build-depends:
        , base
        , Cabal
        , cabal-install-solver
        , Cabal-syntax
        , co-log
        , containers
        , hackage-security
        , http-client
        , mtl
        , optparse-applicative
        , pubgrub
        , pubgrub-cabal
        , pubgrub-hs:bridge
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

test-suite pubgrub-hs-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        FlattenSpec
        IndexStateSpec
        StoredSpec
    build-depends:
        , pubgrub
        , pubgrub-cabal
        , pubgrub-hs:bridge
        , base
        , binary
        , bytestring
        , cabal-install-solver
        , Cabal-syntax
        , containers
        , serialise
        , tasty
        , tasty-hunit
        , text
    hs-source-dirs:   test
    default-language: GHC2021

-- Builds the derived index the bridge reads: every release parsed once and kept
-- in the pre-environment form. See app/BuildIndex.hs and Bridge.Hackage.Store.
executable pubgrub-index
    import:             warnings
    ghc-options:        -rtsopts
    hs-source-dirs:     app
    main-is:            BuildIndex.hs
    build-depends:
        , base
        , Cabal-syntax
        , co-log
        , containers
        , directory
        , hackage-security
        , http-client
        , mtl
        , optparse-applicative
        , pubgrub-cabal
        , pubgrub-hs:bridge
        , text
        , unliftio
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

-- The harness: the one command that produces both deliverables. It drives the
-- pubgrub executable as a child process, once per solver, per problem, per
-- repetition, because peak memory is a per-process number, and writes
-- bench/output/benchmark.md and bench/output/showcase.md. See app/Harness.hs and
-- docs/benchmarking.md. It measures; scripts/gate.sh decides.
executable pubgrub-harness
    import:             warnings
    hs-source-dirs:     app
    main-is:            Harness.hs
    build-depends:
        , base
        , bytestring
        , containers
        , directory
        , filepath
        , optparse-applicative
        , process
        , text
        , time
    default-language:   GHC2021
    default-extensions: ImportQualifiedPost

