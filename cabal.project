-- The six packages of this repository, in dependency order: the solver, its
-- doctests, its cabal instantiation, the bridge to Hackage and to cabal's own
-- solver, the driver, and the research harness that compares the two solvers.
-- pubgrub and pubgrub-cabal are meant for Hackage; the others stay here.
packages:
    pubgrub
    pubgrub-doctest
    pubgrub-cabal
    pubgrub-hs
    pubgrub-cli
    pubgrub-harness

-- GHC 9.14 ships base 4.22 and containers 0.8, which serialise 0.2.6.1 and its
-- cborg, used by the unpublished packages, do not admit yet. Both build against
-- them. The two published packages need nothing here.
if impl(ghc >= 9.14)
    allow-newer: serialise:*, cborg:*

-- pubgrub's doctests run the Haddock examples through the GHC API, which finds
-- the library and its dependencies through a GHC environment file in the
-- project root (gitignored).
write-ghc-environment-files: always
